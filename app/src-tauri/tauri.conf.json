{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anomaly",
  "version": "1.1.0",
  "identifier": "com.nsbro.anomaly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Anomaly",
        "width": 1180,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420,
        "backgroundColor": "#0E1419"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../tools/MBINCompiler.exe": "tools/MBINCompiler.exe",
      "../../tools/hgpaktool.exe": "tools/hgpaktool.exe",
      "../../tools/THIRD-PARTY.md": "tools/THIRD-PARTY.md",
      "../../tools/atlas/xinput9_1_0.dll": "tools/atlas/xinput9_1_0.dll",
      "../../tools/atlas/anomaly_recorder.dll": "tools/atlas/anomaly_recorder.dll",
      "../../tools/sevenzip/7z.exe": "tools/sevenzip/7z.exe",
      "../../tools/sevenzip/7z.dll": "tools/sevenzip/7z.dll",
      "../../tools/sevenzip/License.txt": "tools/sevenzip/License.txt"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "nxm"
        ]
      }
    }
  }
}
