{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "deep-link:default",
    "opener:allow-open-url",
    "core:webview:default",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-size"
  ]
}
